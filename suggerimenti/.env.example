# Copiare in .env accanto a docker-compose.yml e compilare.

# Cloudflare Turnstile (dashboard Cloudflare → Turnstile → Add widget, dominio frase-celebre.taffa-dev.site)
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Cloudflare Access: applicazione su frase-celebre.taffa-dev.site/admin
CF_ACCESS_TEAM_DOMAIN=taffa-dev.cloudflareaccess.com
CF_ACCESS_AUD=
# Chi entra nel pannello (separati da virgole); deve essere ammesso anche dalla policy di Access
ADMIN_EMAIL=

# GitHub: token fine-grained, solo sul repo taffa-dev/Calendario, permesso "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_REPO=taffa-dev/Calendario
GITHUB_BRANCH=master

# Sale per le impronte degli IP (limite di invii): una stringa casuale qualsiasi, es. `openssl rand -hex 16`
SALE_IMPRONTE=

# Notifica Telegram (opzionale; vuote = nessun avviso). Il token è lo stesso WEBHOOK_TOKEN del bot.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_TOKEN=
